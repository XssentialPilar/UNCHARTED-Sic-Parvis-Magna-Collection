{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "system": "Advanced Performance & Diagnostics System (APDS)",
  "version": "1.0.0",
  "default_profile": "STANDARD",
  "profiles": {
    "DISABLED": {
      "enabled": false,
      "description": "Zero overhead mode. All collection hooks are no-ops."
    },
    "LIGHT": {
      "enabled": true,
      "description": "Daily gameplay mode. Minimal overhead (<0.3% FPS impact). Captures global FPS, average frametimes, VRAM, and critical errors.",
      "sampling_interval_ms": 1000,
      "flush_interval_ms": 1000,
      "stutter_threshold_ms": 33.333,
      "enable_per_core_cpu": false,
      "enable_thread_tracing": false,
      "enable_nvml_sensors": true,
      "enable_io_tracking": false,
      "enable_pipeline_tracer": false,
      "watchdog_enabled": true,
      "watchdog_timeout_sec": 5.0,
      "ring_buffer_capacity": 4096
    },
    "STANDARD": {
      "enabled": true,
      "description": "Default diagnostic mode. High accuracy per-core CPU, GPU engines, frametime series, VRAM residency, stutter correlation, and resource tracking.",
      "sampling_interval_ms": 500,
      "flush_interval_ms": 500,
      "stutter_threshold_ms": 25.0,
      "enable_per_core_cpu": true,
      "enable_thread_tracing": true,
      "enable_nvml_sensors": true,
      "enable_io_tracking": true,
      "enable_pipeline_tracer": true,
      "watchdog_enabled": true,
      "watchdog_timeout_sec": 4.0,
      "ring_buffer_capacity": 16384
    },
    "DEEP": {
      "enabled": true,
      "description": "In-depth engineering profiling. Microsecond QPC timestamping, per-draw stats, staging pool allocations, shader compiler hooks, and full telemetry stream.",
      "sampling_interval_ms": 200,
      "flush_interval_ms": 250,
      "stutter_threshold_ms": 20.0,
      "enable_per_core_cpu": true,
      "enable_thread_tracing": true,
      "enable_nvml_sensors": true,
      "enable_io_tracking": true,
      "enable_pipeline_tracer": true,
      "watchdog_enabled": true,
      "watchdog_timeout_sec": 3.0,
      "ring_buffer_capacity": 65536
    },
    "FORENSIC": {
      "enabled": true,
      "description": "Crash and hang reproduction mode. Full circular event buffer, memory fault interception, Windows minidump auto-generation, and hang watchdog.",
      "sampling_interval_ms": 100,
      "flush_interval_ms": 100,
      "stutter_threshold_ms": 16.666,
      "enable_per_core_cpu": true,
      "enable_thread_tracing": true,
      "enable_nvml_sensors": true,
      "enable_io_tracking": true,
      "enable_pipeline_tracer": true,
      "watchdog_enabled": true,
      "watchdog_timeout_sec": 2.5,
      "ring_buffer_capacity": 131072
    }
  },
  "storage": {
    "output_root": "Diagnostics/Sessions",
    "max_stored_sessions": 50,
    "max_session_size_mb": 250,
    "compress_old_sessions": true
  }
}
