<Application x:Class="UnchartedLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="TitleFont">Cinzel, Trajan Pro, Georgia, Times New Roman, serif</FontFamily>
        <FontFamily x:Key="BodyFont">Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>
        <SolidColorBrush x:Key="GoldAccent" Color="#E5C158"/>
        <SolidColorBrush x:Key="GoldDim" Color="#B89738"/>
        <SolidColorBrush x:Key="DarkBg" Color="#0D0F12"/>
        <SolidColorBrush x:Key="CardBg" Color="#181B20"/>
        <SolidColorBrush x:Key="TextLight" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8F96A0"/>
        <SolidColorBrush x:Key="BorderGold" Color="#554420"/>
    </Application.Resources>
</Application>
