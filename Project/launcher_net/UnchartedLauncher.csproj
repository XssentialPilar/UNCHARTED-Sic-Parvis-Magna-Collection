<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>../launcher/assets/uncharted.ico</ApplicationIcon>
    <AssemblyName>Uncharted - Sic Parvis Magna Collection</AssemblyName>
    <RootNamespace>UnchartedLauncher</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../launcher/assets/spm_desk_bg.png" Link="Assets/spm_desk_bg.png" />
    <Resource Include="../launcher/assets/spm_panel_glass.png" Link="Assets/spm_panel_glass.png" />
    <Resource Include="../launcher/assets/spm_journal_u1.png" Link="Assets/spm_journal_u1.png" />
    <Resource Include="../launcher/assets/spm_journal_u1_active.png" Link="Assets/spm_journal_u1_active.png" />
    <Resource Include="../launcher/assets/spm_journal_u2.png" Link="Assets/spm_journal_u2.png" />
    <Resource Include="../launcher/assets/spm_journal_u2_active.png" Link="Assets/spm_journal_u2_active.png" />
    <Resource Include="../launcher/assets/spm_journal_u3.png" Link="Assets/spm_journal_u3.png" />
    <Resource Include="../launcher/assets/spm_journal_u3_active.png" Link="Assets/spm_journal_u3_active.png" />
    <Resource Include="../launcher/assets/uncharted.ico" Link="Assets/uncharted.ico" />
  </ItemGroup>
</Project>
