  command = C:\Users\DiegoPorro\.codex\tmp\uncharted-build\msys64\clang64\bin\cmake.exe -E cmake_ninja_dyndep --tdi=CMakeFiles\wait-diagnostics-test.dir\CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
